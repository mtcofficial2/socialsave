# SocialSave API (Go). Copy to .env and change SECRET_KEY before any shared deploy.
# Existing environment variables win over this file.

APP_NAME=SocialSave API
ENVIRONMENT=development
SECRET_KEY=change-me-in-production
PUBLIC_BASE_URL=http://127.0.0.1:8080
PORT=8080

# When true, /api/v1/platforms, /analyze, and /download require a key.
REQUIRE_API_KEY=false
API_KEYS=

# Comma-separated. YouTube stays metadata-only even when listed.
ENABLED_PLATFORMS=tiktok,instagram,facebook,x,youtube,reddit,pinterest,direct

# Code default and Render value are 2147483648 (2 GiB). This caps a file
# Render assembles before uploading it. It does not lower video quality.
MAX_DOWNLOAD_BYTES=2147483648
# Unused by Auto. Auto, Best, and Original keep the tallest source video.
# 1080p, 1440p, and 4k still cap at the selected height.
DEFAULT_MAX_HEIGHT=1080
TOKEN_TTL_SECONDS=3600
JOB_TTL_SECONDS=600
REQUEST_TIMEOUT_SECONDS=30
MAX_REDIRECTS=3
ANALYZE_RATE_LIMIT=30/minute
DOWNLOAD_RATE_LIMIT=10/minute

# Optional HTTP PUT target. Used only when S3 settings below are empty.
OBJECT_STORAGE_URL=

# false: a failed or missing object-storage upload fails the job.
# The temp file is deleted and Render does not serve /api/v1/files for it.
# true: local debugging only. Render may serve that temp file once.
ALLOW_RENDER_FILE_PROXY=false

# S3-compatible storage for files that must be joined on the server.
# Cloudflare R2, Amazon S3, and Backblaze B2.
# Prefer S3_PUBLIC_BASE_URL so the phone downloads from that host.
# With it empty, the API returns a presigned GET URL and still does not proxy the bytes.
# S3_ENDPOINT=https://ACCOUNT.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=socialsave
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://media.example.com
# S3_URL_TTL_SECONDS=3600

# Official metadata only. These do not unlock blocked downloads.
YOUTUBE_API_KEY=
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_ACCESS_TOKEN=
X_BEARER_TOKEN=

# Optional summaries of videos the phone already saved. Stays on the server.
# https://docs.x.ai — never put this key in the app or the web page.
XAI_API_KEY=
