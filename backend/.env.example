ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-string
PUBLIC_BASE_URL=http://127.0.0.1:8000
REQUIRE_API_KEY=false
API_KEYS=

# Comma-separated. Remove a platform to disable it without changing Flutter.
ENABLED_PLATFORMS=tiktok,instagram,facebook,x,youtube,reddit,pinterest,direct

MAX_DOWNLOAD_BYTES=524288000
TOKEN_TTL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=15

# Optional official API credentials. Never put these in the Flutter app.
YOUTUBE_API_KEY=
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_ACCESS_TOKEN=
X_BEARER_TOKEN=
